# Salin file ini ke .env.local lalu isi nilainya.
# Jangan pernah meng-commit secret asli.

# Database Supabase (Postgres) — pakai Session Pooler URL (port 5432).
# Cara ambil: Supabase > Project Settings > Database > Connection string.
# Port 5432 cocok untuk migrate, seed, dan runtime aplikasi.
# (Port 6543 = transaction pooler, khusus serverless/edge, tidak cocok untuk migrate.)
DATABASE_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# AUTH_SECRET — secret untuk NextAuth v5 (JWT signing).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Google Gemini API key (Section 4). Ambil di https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# URL aplikasi — dipakai untuk membangun tautan di email (mis. reset password).
# Di Vercel: set ke domain production kamu.
APP_URL="http://localhost:3000"

# Email Gmail untuk kirim email reset password (Nodemailer + App Password).
# Syarat: aktifkan 2-Step Verification, lalu buat App Password di
# Google Account > Security > App passwords. GMAIL_USER = alamat email.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
