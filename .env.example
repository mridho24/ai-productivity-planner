# Salin file ini ke .env.local lalu isi nilainya.
# Jangan pernah meng-commit secret asli.

# Database Supabase (Postgres) — pakai Connection Pooling URL (pgbouncer)
# Cara ambil: Supabase > Project Settings > Database > Connection pooling
# Port pooling = 6543. Jangan pakai direct connection (5432).
DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:6543/postgres?pgbouncer=true&connection_limit=1"

# AUTH_SECRET — di-generate nanti saat setup NextAuth (Section 2).
# Bisa buat dengan: npx auth secret
AUTH_SECRET=""

# Google Gemini API key (Section 4). Ambil di https://aistudio.google.com/apikey
GEMINI_API_KEY=""
